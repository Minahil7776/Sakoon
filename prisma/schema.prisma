generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (port 6543) used by the app
  directUrl = env("DIRECT_URL") // direct connection (port 5432) used by migrations
}

enum Role {
  admin
  psychologist
  client
}

enum AccountStatus {
  active
  suspended
  deactivated
}

enum VerificationStatus {
  pending
  approved
  rejected
  additional_info_required
}

enum QualificationType {
  degree
  license
  certification
}

enum ConsultationStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum PaymentRecordKind {
  charge
  refund
}

enum PaymentRecordStatus {
  pending
  succeeded
  failed
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  fullName      String        @map("full_name")
  email         String        @unique // always stored lowercase
  phone         String?
  passwordHash  String        @map("password_hash")
  role          Role
  status        AccountStatus @default(active)
  emailVerified Boolean       @default(false) @map("email_verified")
  timezone      String        @default("Asia/Karachi")
  createdAt     DateTime      @default(now()) @map("created_at")

  clientProfile       ClientProfile?
  psychologistProfile PsychologistProfile?
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model ClientProfile {
  userId String @id @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  consultations Consultation[] @relation("ConsultationClient")

  @@map("client_profiles")
}

model PsychologistProfile {
  userId             String             @id @map("user_id") @db.Uuid
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  reviewNote         String?            @map("review_note") // FR-017: reason shown to the applicant
  reviewedAt         DateTime?          @map("reviewed_at")
  reviewedBy         String?            @map("reviewed_by") @db.Uuid

  // Public profile (what clients see)
  title           String?
  bio             String?
  experienceYears Int?     @map("experience_years") // Legacy value; workExperiences is the displayed source of truth.
  institution     String? // current clinic or affiliation
  languages       String[] @default([])
  photoUrl        String?  @map("photo_url")
  consultationFee Int?     @map("consultation_fee") // PKR per session (FR-021)
  sessionDuration Int?     @map("session_duration") // minutes (FR-022)
  acceptsInstant  Boolean  @default(false) @map("accepts_instant") // FR-046
  // Cached completeness score (0-100), recomputed on every profile change.
  // Client-side search can filter on it: verificationStatus = approved AND profileStrength >= 80.
  profileStrength Int      @default(0) @map("profile_strength")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations PsychologistSpecialization[]
  qualifications  Qualification[]
  workExperiences WorkExperience[]
  consultations   Consultation[]               @relation("ConsultationPsychologist")

  @@index([verificationStatus, profileStrength])
  @@map("psychologist_profiles")
}

model Consultation {
  id             String             @id @default(uuid()) @db.Uuid
  clientId       String             @map("client_id") @db.Uuid
  psychologistId String             @map("psychologist_id") @db.Uuid
  scheduledAt    DateTime           @map("scheduled_at")
  status         ConsultationStatus @default(scheduled)
  amountPkr      Int                @map("amount_pkr")
  completedAt    DateTime?          @map("completed_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  client       ClientProfile         @relation("ConsultationClient", fields: [clientId], references: [userId], onDelete: Restrict)
  psychologist PsychologistProfile   @relation("ConsultationPsychologist", fields: [psychologistId], references: [userId], onDelete: Restrict)
  payments     ConsultationPayment[]

  @@index([status, completedAt])
  @@index([clientId, scheduledAt])
  @@index([psychologistId, scheduledAt])
  @@map("consultations")
}

model ConsultationPayment {
  id             String              @id @default(uuid()) @db.Uuid
  consultationId String              @map("consultation_id") @db.Uuid
  kind           PaymentRecordKind   @default(charge)
  status         PaymentRecordStatus @default(pending)
  amountPkr      Int                 @map("amount_pkr")
  processedAt    DateTime?           @map("processed_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@index([status, processedAt])
  @@index([consultationId])
  @@map("consultation_payments")
}

model Specialization {
  id            Int                          @id @default(autoincrement())
  name          String                       @unique
  psychologists PsychologistSpecialization[]

  @@map("specializations")
}

model PsychologistSpecialization {
  psychologistId   String  @map("psychologist_id") @db.Uuid
  specializationId Int     @map("specialization_id")
  isPrimary        Boolean @default(false) @map("is_primary")

  psychologist   PsychologistProfile @relation(fields: [psychologistId], references: [userId], onDelete: Cascade)
  specialization Specialization      @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([psychologistId, specializationId])
  @@index([specializationId])
  @@map("psychologist_specializations")
}

model Qualification {
  id             String            @id @default(uuid()) @db.Uuid
  psychologistId String            @map("psychologist_id") @db.Uuid
  type           QualificationType
  title          String
  institution    String
  year           Int?
  reference      String? // licence number
  createdAt      DateTime          @default(now()) @map("created_at")

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [userId], onDelete: Cascade)

  @@index([psychologistId])
  @@map("qualifications")
}

model WorkExperience {
  id             String    @id @default(uuid()) @db.Uuid
  psychologistId String    @map("psychologist_id") @db.Uuid
  title          String
  organization   String
  location       String?
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  current        Boolean   @default(false)
  description    String?
  documentPath   String?   @map("document_path")
  createdAt      DateTime  @default(now()) @map("created_at")

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [userId], onDelete: Cascade)

  @@index([psychologistId, startDate])
  @@map("work_experiences")
}

// FR-147: append-only record of administrative actions
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

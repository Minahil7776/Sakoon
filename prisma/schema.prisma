generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (port 6543) used by the app
  directUrl = env("DIRECT_URL")   // direct connection (port 5432) used by migrations
}

enum Role {
  admin
  psychologist
  client
}

enum AccountStatus {
  active
  suspended
  deactivated
}

enum VerificationStatus {
  pending
  approved
  rejected
  additional_info_required
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  fullName      String        @map("full_name")
  email         String        @unique // always stored lowercase
  phone         String?
  passwordHash  String        @map("password_hash")
  role          Role
  status        AccountStatus @default(active)
  emailVerified Boolean       @default(false) @map("email_verified")
  timezone      String        @default("Asia/Karachi")
  createdAt     DateTime      @default(now()) @map("created_at")

  clientProfile       ClientProfile?
  psychologistProfile PsychologistProfile?
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model ClientProfile {
  userId String @id @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model PsychologistProfile {
  userId             String             @id @map("user_id") @db.Uuid
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  reviewNote         String?            @map("review_note") // FR-017: reason shown to the applicant
  reviewedAt         DateTime?          @map("reviewed_at")
  reviewedBy         String?            @map("reviewed_by") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@map("psychologist_profiles")
}

// FR-147: append-only record of administrative actions
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}
